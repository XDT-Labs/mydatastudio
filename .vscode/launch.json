{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "client (dev)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Dev Pubspec",
        },
        {
            "name": "client (dev w/remote server)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Dev Pubspec",
            "args": [
                "--dart-define=PYTHON_SERVER_URL=http://127.0.0.1:8000"
            ]
        },
        {
            "name": "client (prod)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Prod Pubspec",
            "flutterMode": "release",
            "args": []
        },
        {
            "name": "client (impeller)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "args": [
                "--enable-impeller"
            ]
        },
        {
            "name": "aichat server (python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/aiserver/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/aiserver",
            "justMyCode": true,
            // Resolved via pdm rather than a hardcoded .venv path: pdm's own
            // interpreter (see `pdm info`, or aiserver/.pdm-python) lives
            // outside the workspace and is machine/worktree-specific, so it
            // can't be committed here. Run "Python: Select Interpreter" once
            // and pick the pdm-managed environment for aiserver (VS Code's
            // Python extension auto-detects it); this then just reuses that
            // selection.
            "python": "${command:python.interpreterPath}",
            "env": {
                "AICHAT_PORT": "8000",
                // Normally set by PythonManager when it spawns the bundled
                // binary. Running the server standalone, nothing sets it, and
                // resolve_data_roots() then refuses every caller-supplied path
                // with a 403 — PST import and thumbnails fail while the rest of
                // the server looks perfectly healthy.
                //
                // There is a fallback that probes the known bundle ids, but it
                // takes com.xdtlabs.mydatastudio.dev before com.xdtlabs.mydatastudio
                // and both may exist locally, so debugging a non-dev build would
                // silently resolve to the wrong directory. Being explicit avoids that.
                //
                // ${userHome} keeps this portable — do not hardcode /Users/<name>,
                // this file is committed.
                "APP_SUPPORT_DIR": "${userHome}/Library/Application Support/com.xdtlabs.mydatastudio.dev"
            }
        },
        {
            "name": "client (profile mode)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": []
        }
    ],
    "compounds": [
        {
            "name": "client + server (dev)",
            "configurations": [
                "aichat server (python)",
                "client (dev w/remote server)"
            ]
        }
    ]
}