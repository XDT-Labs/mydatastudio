{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "client (dev)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Dev Pubspec",
        },
        {
            "name": "client (dev w/remote server)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Dev Pubspec",
            "args": [
                "--dart-define=PYTHON_SERVER_URL=http://127.0.0.1:8000"
            ]
        },
        {
            "name": "client (prod)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "Use Prod Pubspec",
            "flutterMode": "release",
            "args": []
        },
        {
            "name": "client (impeller)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "args": [
                "--enable-impeller"
            ]
        },
        {
            "name": "aichat server (python)",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "Ensure aiserver venv",
            "program": "${workspaceFolder}/aiserver/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/aiserver",
            "justMyCode": true,
            "python": "${workspaceFolder}/aiserver/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/aiserver/src",
                "AICHAT_PORT": "8000",
                "APP_SUPPORT_DIR": "${env:HOME}/Library/Application Support/com.xdtlabs.mydatastudio.dev",
                // Must match PythonManager.modelsDirFor, which the packaged app
                // passes as AICHAT_MODELS_DIR. Without it the server falls back
                // to the legacy <support>/aichat/models, which on this machine
                // still holds a 362 MB truncated gemma-4-12B download — so the
                // dev server starts, fails to load the model, and every chat,
                // description, and cluster-label request fails against a server
                // that looks healthy.
                "AICHAT_MODELS_DIR": "${env:HOME}/Library/Application Support/com.xdtlabs.mydatastudio.dev/models"
            }
        },
        {
            "name": "client (profile mode)",
            "cwd": "client",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": []
        }
    ],
    "compounds": [
        {
            "name": "client + server (dev)",
            "configurations": [
                "aichat server (python)",
                "client (dev w/remote server)"
            ]
        }
    ]
}