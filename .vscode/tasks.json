{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean app dir",
            "type": "shell",
            "command": "rm -fr '${env:HOME}/Library/Application Support/com.xdtlabs.mydatastudio' && rm -fr client/app/*.zip",
            "problemMatcher": []
        },
        {
            "label": "Build aichat (macOS)",
            "type": "shell",
            "command": "cd aiserver && pdm install && pdm run pyinstaller -y main.spec && mkdir -p ../client/app && rm -f ../client/app/aiserver-macos.zip && cd dist/aichat && zip -r ../../../client/app/aiserver-macos.zip .",
            "problemMatcher": [],
            "group": "build"
        },
        {
            // The python launch configs point at aiserver/.venv/bin/python, but
            // .venv is gitignored while .vscode/launch.json is tracked — so a
            // fresh worktree always has the config and never has the
            // interpreter, and launching the server fails.
            //
            // `pdm install` alone does NOT fix it. aiserver/.pdm-python holds an
            // absolute path to the main checkout's .venv and follows the tree
            // into every new worktree, so pdm re-syncs that venv, reports
            // success, and creates nothing locally. Deleting the stale pointer
            // first is what makes pdm honour venv.in_project and build one
            // here (~15s, 124 packages).
            //
            // No-op once the venv exists, so it costs nothing on every launch.
            "label": "Ensure aiserver venv",
            "type": "shell",
            "command": "cd aiserver && ([ -x .venv/bin/python ] || (rm -f .pdm-python && pdm install))",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Use Dev Pubspec",
            "type": "shell",
            "command": "cp client/pubspec.dev.yaml client/pubspec.yaml",
            "problemMatcher": []
        },
        {
            "label": "Use Prod Pubspec",
            "type": "shell",
            "command": "cp client/pubspec.prod.yaml client/pubspec.yaml",
            "problemMatcher": []
        }
    ]
}